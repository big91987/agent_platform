{
  "name": "编排验收 · 澄清与真实返工",
  "enabled": true,
  "entry": "issue",
  "start_nodes": [],
  "authorized_users": [],
  "max_steps": 8,
  "nodes": [
    {
      "id": "issue",
      "name": "建立验收 Issue",
      "kind": "connector",
      "connector_id": "issue",
      "connector_input": {
        "title": "智能体编排验收：澄清、返工与通知"
      },
      "x": 50,
      "y": 60
    },
    {
      "id": "writer",
      "name": "内容编写",
      "kind": "agent",
      "agent": {
        "executor": "codex",
        "instructions": "首次进入时只问用户发布版本号是多少，等待回答后写 release.md，包含 # 发布说明 和版本号即可；首次不增加验收记录章节。这是明确的返工测试。用户回复后马上写文件并 handoff 给 reviewer。再次进入时阅读前序 reviewer 的真实反馈修正文件，不重复问版本号，再 handoff 给 reviewer。无需 Git 提交。"
      },
      "x": 340,
      "y": 60
    },
    {
      "id": "reviewer",
      "name": "独立校验",
      "kind": "agent",
      "agent": {
        "executor": "codex",
        "instructions": "读取 release.md，检查版本号存在，并且存在 ## 验收记录 章节。若缺失，使用 handoff 交回 writer，明确要求补齐 ## 验收记录 和 校验通过 文字，inputs 携带 missing_section。若已齐备，实际用命令验证文件后 complete_node，省略 route，summary 记录通过。这是有意注入缺失章节的真实返工验收，不要自行改文件。"
      },
      "x": 630,
      "y": 60
    },
    {
      "id": "done",
      "name": "验收完成",
      "kind": "end",
      "x": 630,
      "y": 280
    }
  ],
  "edges": [
    {
      "source": "issue",
      "route": "next",
      "target": "writer",
      "mode": "automatic",
      "description": "创建成功"
    },
    {
      "source": "writer",
      "route": "review",
      "target": "reviewer",
      "mode": "handoff",
      "description": "内容就绪"
    },
    {
      "source": "reviewer",
      "route": "rework",
      "target": "writer",
      "mode": "handoff",
      "description": "内容缺失返工"
    },
    {
      "source": "reviewer",
      "route": "next",
      "target": "done",
      "mode": "automatic",
      "description": "校验完成"
    }
  ],
  "hooks": [
    {
      "event": "node.started",
      "connector_id": "comment",
      "input": {
        "issue_node": "issue"
      },
      "body": "开始：{{node_name}}\n\n[进入会话]({{conversation_url}})"
    },
    {
      "event": "agent.reply.completed",
      "connector_id": "comment",
      "input": {
        "issue_node": "issue"
      },
      "body": "{{node_name}}：\n\n{{text}}\n\n[继续会话]({{conversation_url}})"
    },
    {
      "event": "handoff.after",
      "connector_id": "comment",
      "input": {
        "issue_node": "issue"
      },
      "body": "交接 {{node}} → {{target}}\n\n{{summary}}"
    },
    {
      "event": "run.completed",
      "connector_id": "comment",
      "input": {
        "issue_node": "issue"
      },
      "body": "编排验收完成。\n\n[运行记录]({{run_url}})"
    }
  ],
  "context_version": 2
}
